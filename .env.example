# ---------------------------------------------------------------------------
# Copy to .env.local and fill in with values from your Neon project dashboard.
#   cp .env.example .env.local
# .env.local is gitignored. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- SERVER ONLY -----------------------------------------------------------
# Not prefixed NEXT_PUBLIC_, so Next.js will not compile these into the browser
# bundle. Never import them from a "use client" file.

# Direct Postgres connection string. BYPASSES RLS entirely.
# Used ONLY by `npm run db:push` to apply db/schema.sql. The app never uses it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Data API URL used by the server-side route handlers that perform writes.
# Same value as NEXT_PUBLIC_NEON_DATA_API_URL below; kept separate so server
# code never has to reach for a public variable.
NEON_DATA_API_URL=https://YOUR-DATA-API-ENDPOINT.neon.tech/DBNAME/rest/v1

# --- PUBLIC ----------------------------------------------------------------
# Compiled into the client bundle and readable by anyone who opens devtools.
# That is fine and intended: these are endpoints, not credentials. RLS in
# Postgres is what protects the data behind them.

NEXT_PUBLIC_NEON_AUTH_URL=https://YOUR-AUTH-ENDPOINT.neon.tech
NEXT_PUBLIC_NEON_DATA_API_URL=https://YOUR-DATA-API-ENDPOINT.neon.tech/DBNAME/rest/v1
